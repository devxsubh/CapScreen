# =============================================================================
# CapScreen — monorepo environment
# =============================================================================
# Local dev:  copy to `.env` at repo root → `pnpm dev` (backend + frontend on host)
# Production: copy to `.env.production` on EC2 → `docker compose --env-file .env.production up -d --build`
# Vercel:     set NEXT_PUBLIC_* in project settings (frontend only)
#
# Backend reads env via backend/src/loadEnv.ts
# Frontend reads via next.config.ts (NEXT_PUBLIC_* only is exposed to browser)
#
# Deployment topology: docs/ARCHITECTURE.md

# --- Frontend (Next.js) ---
# Local: http://localhost:3001  |  Vercel: https://<your-ec2-or-alb-host>
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Local dev only — bypasses login (never in production)
# NEXT_PUBLIC_ALLOW_PREVIEW_MODE=true

# --- Backend server ---
PORT=3001
# Local: http://localhost:3000  |  Production: https://<your-vercel-app>.vercel.app (CORS + cookies)
FRONTEND_URL=http://localhost:3000

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/vc-screener

# JWT auth (RS256) — generate with: pnpm --filter vc-screener-backend run generate:jwt-keys
JWT_ACCESS_TOKEN_SECRET_PRIVATE=
JWT_ACCESS_TOKEN_SECRET_PUBLIC=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Encrypt per-user API keys at rest (min 32 chars, unique random value)
USER_API_KEYS_ENCRYPTION_SECRET=

# Local dev only — allows unauthenticated API access as preview-user (never in production)
# ALLOW_PREVIEW_MODE=true

# Resend — transactional email (verification, password reset, invites)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# EMAIL_APP_NAME=CapScreen
# EMAIL_LOGO_URL=https://your-domain.example/logo.png

# ── Model provider (backend/src/lib/llm/providers/) ──────────────────────
# Default: Anthropic + claude-haiku-4-5 via ANTHROPIC_API_KEY (console.anthropic.com).
ANTHROPIC_API_KEY=
# Any other provider — presets: anthropic | openai | ollama | lmstudio | llamacpp |
# openrouter | groq | gemini. Anything else is treated as a custom OpenAI-compatible
# server and needs LLM_BASE_URL. Loopback base URLs count as local (no data egress).
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_UTILITY_MODEL=          # narratives / CSV inference / extraction (defaults to LLM_MODEL)
# LLM_BASE_URL=
# LLM_API_KEY=                # overrides the preset's key env var (OPENAI_API_KEY, GROQ_API_KEY, …)
# LLM_SUPPORTS_TOOLS=false    # for local models without function calling
# LLM_CONFIG_FILE=            # JSON { providers, roles } — takes precedence over the vars above

# Watchman sanctions screening API
# Local: http://localhost:8084 (docker-compose.dev.yml)
# EC2:   http://watchman:8084 (overridden by docker-compose.yml — do not set localhost in production)
WATCHMAN_URL=http://localhost:8084

# EC2 behind ALB/nginx reverse proxy (docker-compose.yml sets TRUST_PROXY_HOPS=1)
# TRUST_PROXY_HOPS=1

# F17 — web search agent (optional; must be on its own line — do not append other vars)
TAVILY_API_KEY=

# F12 — scheduled portfolio re-screen (optional)
# RESCREEN_SCHEDULER_ENABLED=true
# RESCREEN_INTERVAL_HOURS=168
# DIGEST_WEBHOOK_URL=

# Screening thresholds (optional)
# SCREENING_WATCHMAN_MIN_MATCH=0.80
# SCREENING_FLAGGED_MIN_SCORE=0.95
# SCREENING_REVIEW_MIN_SCORE=0.80
# SCREENING_UBO_PCT_THRESHOLD=25
# SCREENING_OFAC_50_PCT_THRESHOLD=50
# SCREENING_LOG=1

# AUDIT_LOG_RETENTION_DAYS=1825
# DATA_RESIDENCY=            # restricted|eu|in — blocks PII to remote LLMs; local models still allowed

# Rate limits (optional)
# RATE_LIMIT_SCREENER_CHAT_MAX=60
# RATE_LIMIT_ASSISTANT_CHAT_MAX=40

# Cloudflare R2 object storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=capscreen-screener
R2_PUBLIC_URL=

# Upstash Redis — Watchman result cache (optional; falls back to in-memory)
# Get from console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RAG — document upload & vector search (optional)
# Atlas Vector Search requires MONGO_VECTOR_SEARCH_ENABLED=true + an Atlas cluster
# with a vector index on the embeddings collection.
OPENAI_API_KEY=
MONGO_VECTOR_SEARCH_ENABLED=true

# ── Cloud auth service (backend/src/authService, deployed on Vercel) ───────
# Accounts only — no screening data. Set these in the Vercel project, not here.
# CAPSCREEN_DB=mongodb
# MONGODB_URI=
# JWT_ACCESS_TOKEN_SECRET_PRIVATE=   # pnpm --filter vc-screener-backend run generate:jwt-keys
# JWT_ACCESS_TOKEN_SECRET_PUBLIC=
# FRONTEND_URL=https://<your-auth-service>.vercel.app
# RESEND_API_KEY=                     # email verification + password reset
# DESKTOP_REFRESH_TOKEN_EXPIRATION_DAYS=30
