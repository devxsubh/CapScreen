# =============================================================================
# CapScreen — developer environment
# =============================================================================
# The desktop app (`pnpm desktop`, installers) never reads this file: the
# Electron shell passes everything the backend needs, and models/keys are set
# in the app's AI Control Center.
#
# This file is for:
#   - browser-only dev:  copy to `.env` at repo root → `pnpm dev`
#     (backend :3001 + Next :3000, data in ~/.capscreen, Watchman via
#      `docker compose -f docker-compose.dev.yml up`)
#   - the cloud auth service (bottom section) — set those in Vercel instead.
#
# Backend reads env via backend/src/loadEnv.ts; the frontend only sees NEXT_PUBLIC_*.

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Backend ---
PORT=3001
FRONTEND_URL=http://localhost:3000

# Watchman sanctions engine (docker-compose.dev.yml)
WATCHMAN_URL=http://localhost:8084

# ── Models (backend/src/lib/llm/providers/) ──────────────────────────────────
# Used only when the AI Control Center has no configuration yet.
# Default: Anthropic + claude-haiku-4-5 via ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Any other provider — presets: anthropic | openai | ollama | lmstudio | llamacpp |
# openrouter | groq | gemini. Anything else is treated as a custom OpenAI-compatible
# server and needs LLM_BASE_URL. Loopback base URLs count as local (no data egress).
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_UTILITY_MODEL=          # narratives / CSV inference / extraction (defaults to LLM_MODEL)
# LLM_BASE_URL=
# LLM_API_KEY=                # overrides the preset's key env var (OPENAI_API_KEY, GROQ_API_KEY, …)
# LLM_SUPPORTS_TOOLS=false    # for local models without function calling
# LLM_CONFIG_FILE=            # JSON { providers, roles } — takes precedence over the vars above

# Document search embeddings (optional; without one, search falls back to keywords)
# OPENAI_API_KEY=
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=

# Web search agent tool (optional; each query needs the user's approval)
TAVILY_API_KEY=

# Re-screen digest webhook (optional; background re-screening is configured in the app)
# DIGEST_WEBHOOK_URL=

# Screening thresholds (optional)
# SCREENING_WATCHMAN_MIN_MATCH=0.80
# SCREENING_FLAGGED_MIN_SCORE=0.95
# SCREENING_REVIEW_MIN_SCORE=0.80
# SCREENING_UBO_PCT_THRESHOLD=25
# SCREENING_OFAC_50_PCT_THRESHOLD=50
# SCREENING_LOG=1

# AUDIT_LOG_RETENTION_DAYS=1825
# DATA_RESIDENCY=            # restricted|eu|in — blocks PII to remote LLMs; local models still allowed

# ── Cloud auth service (backend/src/authService, deployed on Vercel) ───────
# Accounts only — no screening data. Set these in the Vercel project.
# Local run: pnpm --filter vc-screener-backend auth:dev  (port 4100)
# CAPSCREEN_DB=mongodb
# MONGODB_URI=
# JWT_ACCESS_TOKEN_SECRET_PRIVATE=   # pnpm --filter vc-screener-backend run generate:jwt-keys
# JWT_ACCESS_TOKEN_SECRET_PUBLIC=
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
# REFRESH_TOKEN_EXPIRATION_DAYS=7
# DESKTOP_REFRESH_TOKEN_EXPIRATION_DAYS=30
# FRONTEND_URL=https://<your-auth-service>.vercel.app
# RESEND_API_KEY=                     # email verification + password reset
# RESEND_FROM_EMAIL=onboarding@resend.dev
# EMAIL_APP_NAME=CapScreen
# EMAIL_LOGO_URL=
